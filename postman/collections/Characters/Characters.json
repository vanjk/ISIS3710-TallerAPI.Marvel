              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/characters",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "characters"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Obtener por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });\npm.test(\"Es Iron Man con su equipo\", function () { const c = pm.response.json(); pm.expect(c.alias).to.eql(\"Iron Man\"); pm.expect(c.team.name).to.eql(\"Avengers\"); });"
